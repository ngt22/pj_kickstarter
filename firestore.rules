rules_version = '2';

// 案件の原稿を書き込めるのは管理者（カスタムクレーム admin: true）だけ。
// ingest CLI は Admin SDK（ルールを通らない）か、login した管理者のトークン（ルールを通る）で書き込む。
// 管理者は全案件を読めて、閲覧権限（access）を編集でき、案件を作成・削除できる（Web の「案件の管理」画面から）。
// クライアントは access/{自分のメール}.projects に含まれる案件だけを読める。
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function canView(projectId) {
      let access = /databases/$(database)/documents/access/$(myEmail());
      return isAdmin() || (signedIn() && exists(access) && projectId in get(access).data.projects);
    }

    // ingest の ProjectMeta（members を除く）と同じ項目だけを許す
    function validProject(projectId) {
      let data = request.resource.data;
      return data.keys().hasOnly(["id", "name", "summary", "status", "client", "proposed_at", "version", "color", "updatedAt"])
        && data.id == projectId
        && projectId.matches('^[a-z0-9][a-z0-9-]*$')
        && data.name is string
        && data.status in ["draft", "proposed", "approved", "archived"];
    }

    function validDoc(docType) {
      let data = request.resource.data;
      return data.keys().hasOnly(["type", "title", "order", "format", "body", "updatedAt"])
        && data.type == docType
        && data.title is string
        && data.order is int
        && data.format in ["markdown", "yaml"]
        && data.body is string;
    }

    // lib/annotations.ts の Annotation と同じ項目だけを許す
    function validAnnotation() {
      let data = request.resource.data;
      return data.keys().hasOnly(["docType", "authorUid", "authorName", "authorEmail", "items", "comment", "tags", "status", "anchor", "width", "createdAt", "updatedAt"])
        && data.docType is string
        && data.authorName is string
        && data.items is list && data.items.size() > 0 && data.items.size() <= 300
        && data.comment is string && data.comment.size() <= 2000
        && data.tags is list && data.tags.size() <= 20
        && data.status in ["open", "close"]
        && data.anchor is map
        && data.width is number
        && data.updatedAt == request.time;
    }

    match /projects/{projectId} {
      allow read: if canView(projectId);
      allow create, update: if isAdmin() && validProject(projectId);
      allow delete: if isAdmin();

      match /docs/{docType} {
        allow read: if canView(projectId);
        allow create, update: if isAdmin() && validDoc(docType);
        allow delete: if isAdmin();
      }

      // 付箋（閲覧中に書き込む指示）。案件を見られる人なら誰でも貼れる。
      // クライアントは自分の付箋だけを読み書きでき、ほかのクライアントや管理者の付箋は見えない。
      // 管理者は案件のすべての付箋を読めて、状態（open / close）・ハッシュタグ・補足の変更と削除ができる。
      // 書き込み（items）は、囲みの大きさを後から変えるために書き換えられる。
      // 書いた人（authorUid など）・目印の位置・作成時刻は、あとから誰も書き換えられない。
      match /annotations/{annotationId} {
        allow read: if isAdmin() || (canView(projectId) && resource.data.authorUid == request.auth.uid);
        allow create: if canView(projectId) && validAnnotation()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorEmail == myEmail()
          && request.resource.data.status == "open"
          && request.resource.data.createdAt == request.time;
        allow update: if (isAdmin() || (canView(projectId) && resource.data.authorUid == request.auth.uid))
          && validAnnotation()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "tags", "comment", "items", "updatedAt"]);
        allow delete: if isAdmin() || (canView(projectId) && resource.data.authorUid == request.auth.uid);
      }
    }

    // サイト共通の設定。site は表紙に出す提案者（自社名・担当者）で、ログインした人なら誰でも読める。
    // private は push 時の禁止語（社内のあだ名など）で、クライアントに見えないよう管理者だけが読める。
    match /settings/site {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["vendor_name", "contact", "updatedAt"])
        && request.resource.data.vendor_name is string
        && request.resource.data.contact is string;
    }
    match /settings/private {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["forbidden_terms", "updatedAt"])
        && request.resource.data.forbidden_terms is list;
    }

    // 閲覧権限。ドキュメントIDは小文字のメールアドレス。
    // 閲覧者リストを案件側に持たないので、クライアント同士でお互いのメールは見えない。
    match /access/{email} {
      allow read: if isAdmin() || (signedIn() && myEmail() == email);
      allow create, update: if isAdmin()
        && email == email.lower()
        && request.resource.data.keys().hasOnly(["projects", "updatedAt"])
        && request.resource.data.projects is list;
      allow delete: if isAdmin();
    }
  }
}
